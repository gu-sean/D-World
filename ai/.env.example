# 이 파일을 .env로 복사한 뒤 실제 값은 .env에만 입력하세요.
LLM_PROVIDER=mock
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.8-flash
LLM_PLAN_LOCAL_FALLBACK=false
GEMINI_THINKING_LEVEL=low

INTERNAL_API_TOKEN=replace-with-the-same-32-character-token
BACKEND_CALLBACK_URL=http://localhost:3000/internal/v1/ai-callbacks

APP_ENV=development
SENSOR_ENGINE=fixed

# Gemini 호출 한도·응답 길이 (README 주요 설정)
LLM_MAX_REQUESTS_PER_MINUTE=5
LLM_MAX_REQUESTS_PER_DAY=100
GEMINI_MAX_OUTPUT_TOKENS=16384
LLM_DIFFICULTY_MODE=chain

# 영상 인증: 로컬 MinIO(docker compose --profile minio up -d minio) + MediaPipe
# samples/ 폴더만 쓰려면 VISION_MEDIA_SOURCE=local + 실행 환경에 VISION_ENABLE_LOCAL=true
VISION_MEDIA_SOURCE=r2
VISION_ENGINE=mediapipe
VISION_AUTO_DECISION=true
POSE_MODEL_PATH=models/pose_landmarker_lite.task
MEDIA_REGISTRY_PATH=data/media_registry.sqlite3
R2_ENDPOINT=http://localhost:9000
R2_ACCESS_KEY_ID=minioadmin
R2_SECRET_ACCESS_KEY=minioadmin
R2_BUCKET=dworld-dev
