# 이 파일을 .env로 복사한 뒤 실제 값은 .env에만 입력하세요. (키·토큰은 비워 둠)
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.8-flash
# Gemini가 503 등으로 실패하면 규칙 계획(app/llm/local_plan.py)으로 대신 만든다
LLM_PLAN_LOCAL_FALLBACK=true
GEMINI_THINKING_LEVEL=low

# 백엔드 .env의 INTERNAL_API_TOKEN과 같은 값 (32자 이상)
INTERNAL_API_TOKEN=
BACKEND_CALLBACK_URL=http://localhost:3000/internal/v1/ai-callbacks

APP_ENV=development
SENSOR_ENGINE=fixed

# Gemini 호출 한도·응답 길이 (README 주요 설정)
LLM_MAX_REQUESTS_PER_MINUTE=15
LLM_MAX_REQUESTS_PER_DAY=500
GEMINI_MAX_OUTPUT_TOKENS=16384
# single: 난이도 추천을 한 번 호출로 (약 3초), chain: 여러 단계 (약 6초)
LLM_DIFFICULTY_MODE=single

# 영상 인증: 백엔드와 같은 Cloudflare R2 버킷에서 영상을 내려받아 MediaPipe로 분석
# (backend/.env.supabase의 R2 값과 같게. 로컬 MinIO를 쓰면 R2_ENDPOINT=http://localhost:9000)
# samples/ 폴더만 쓰려면 VISION_MEDIA_SOURCE=local + 실행 환경에 VISION_ENABLE_LOCAL=true
VISION_MEDIA_SOURCE=r2
VISION_ENGINE=mediapipe
VISION_AUTO_DECISION=true
# 인증 실패 시 Gemini로 '다시 할 때 고칠 점' 코칭 (false면 규칙 문장만)
VISION_AI_COACHING=true
POSE_MODEL_PATH=models/pose_landmarker_lite.task
MEDIA_REGISTRY_PATH=data/media_registry.sqlite3
R2_ENDPOINT=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=d-world-dev
