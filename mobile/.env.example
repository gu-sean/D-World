API_BASE_URL=http://localhost:3000/api/v1
APP_ENV=development
SOCIAL_LOGIN_MODE=mock
APP_VERSION=0.1.0
# 네이버 클라우드 플랫폼 > AI·NAVER API > Maps 의 Client ID. 비우면 러닝 경로를 지도 없이 선으로 그린다
NAVER_MAP_CLIENT_ID=
# 소셜 로그인 (SOCIAL_LOGIN_MODE=real일 때). 구글은 OAuth "웹 애플리케이션" 클라이언트 ID (Android 클라이언트는 콘솔에 패키지·SHA-1 등록만)
GOOGLE_WEB_CLIENT_ID=
# 네이버 개발자 센터 > 애플리케이션 (Android 패키지 com.dworld)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
