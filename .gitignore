# ── 공통: OS·에디터·도구 ──────────────────────────────────────
.DS_Store
Thumbs.db
Desktop.ini
.idea/
.vscode/
*.swp
*.swo
*~

# ── 공통: 임시 파일 ───────────────────────────────────────────
tmp/
temp/
*.tmp
*.bak

# ── 비밀값·키 (절대 커밋 금지) ────────────────────────────────
# 환경 변수 파일은 .env.example 만 커밋한다
.env
# .env.*
!.env.example
.envrc
# 서명 키·인증서
*.keystore
*.jks
*.p8
*.p12
*.pem
# 외부 서비스 계정·설정 (FCM 서비스 계정 JSON 포함)
google-services.json
GoogleService-Info.plist
service-account*.json
*-firebase-adminsdk-*.json

# ── Node 공통: backend · admin-web · mobile ───────────────────
node_modules/
dist/
build/
coverage/
*.tsbuildinfo
.eslintcache
# 패키지 매니저 로그
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── admin-web (Vite) ──────────────────────────────────────────
admin-web/.vite/
admin-web/dist/

# ── mobile (React Native) ─────────────────────────────────────
.expo/
.metro-health-check*
mobile/.bundle/
mobile/vendor/bundle/
# Android
mobile/android/app/build/
mobile/android/build/
mobile/android/.gradle/
mobile/android/local.properties
*.apk
*.aab
# iOS
mobile/ios/Pods/
mobile/ios/build/
mobile/ios/.xcode.env.local
xcuserdata/
DerivedData/
*.xcuserstate
# 번들 산출물
*.jsbundle

# ── backend (NestJS) ──────────────────────────────────────────
# 빌드 결과(dist/)·환경 파일(.env)은 위 공통 규칙이 처리한다
backend/.swc/
backend/.nest/

# ── DB ────────────────────────────────────────────────────────
# 마이그레이션·시드(.sql)는 커밋 대상이므로 .sql 자체는 무시하지 않는다
*.dump
*.backup
*.sql.gz

# ── 미디어·모델·데이터 ────────────────────────────────────────
# 사람이 나온 영상·라벨링 데이터는 커밋 금지
*.mp4
*.mov
*_Labeling.zip
# ai 모델 가중치(용량·라이선스): ai/models/.gitkeep 만 남긴다
ai/models/*
!ai/models/.gitkeep
ai/local-samples/
*.task
*.pt
*.onnx

# ══════════════════════════════════════════════════════════════
# ai (Python / FastAPI)
# ══════════════════════════════════════════════════════════════
# 바이트코드·확장 모듈
__pycache__/
*.py[cod]
*$py.class
*.so

# 가상환경 (폴더 이름이 흔해 ai/ 로 한정)
.venv/
ai/venv/
ai/env/
ai/ENV/

# 패키징·빌드 산출물
ai/build/
ai/dist/
ai/.eggs/
ai/wheels/
*.egg-info/
*.egg
pip-log.txt

# 테스트·린트·타입 검사 캐시
.pytest_cache/
.ruff_cache/
.mypy_cache/
.dmypy.json
.pyre/
.pytype/
.tox/
.nox/
.hypothesis/

# 커버리지 리포트
htmlcov/
.coverage
.coverage.*
coverage.xml

# 노트북
.ipynb_checkpoints/
