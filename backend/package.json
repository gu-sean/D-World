{
  "name": "backend",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.js\" \"test/**/*.js\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config test/config/jest.unit.cjs",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch --config test/config/jest.unit.cjs",
    "test:debug": "node --inspect-brk --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand --config test/config/jest.e2e.cjs",
    "test:e2e": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config test/config/jest.e2e.cjs",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.mjs",
    "format:check": "prettier --check \"src/**/*.js\" \"test/**/*.js\"",
    "lint": "prettier --check \"src/**/*.js\" \"scripts/**/*.mjs\"",
    "db:verify": "docker compose -f ../docker-compose.yml exec -T -e PGUSER=dworld -e PGPASSWORD=dworld postgres sh /db/scripts/verify.sh",
    "db:reset": "node --env-file-if-exists=.env scripts/migrate.mjs reset",
    "db:seed": "node --env-file-if-exists=.env scripts/seed.mjs",
    "db:seed:demo": "nest build && node --env-file-if-exists=.env scripts/seed-demo.mjs",
    "demo:supabase": "node scripts/supabase.mjs",
    "demo:fill": "node --env-file=.env scripts/seed-demo-fill.mjs",
    "push:check": "node --env-file-if-exists=.env scripts/push-check.mjs",
    "weather:check": "node --env-file-if-exists=.env scripts/weather-check.mjs",
    "openapi:export": "node --env-file-if-exists=.env scripts/export-openapi.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1161.0",
    "@aws-sdk/s3-request-presigner": "^3.1161.0",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/swagger": "^11.4.8",
    "@nestjs/throttler": "^6.7.1",
    "argon2": "^0.45.1",
    "cookie-parser": "^1.4.7",
    "dayjs": "^1.11.23",
    "firebase-admin": "^14.5.0",
    "helmet": "^8.3.0",
    "jose": "^6.2.15",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@swc/cli": "^0.8.2",
    "@swc/core": "^1.16.21",
    "@types/jest": "^30.0.0",
    "chokidar": "^5.0.0",
    "jest": "^30.5.2",
    "prettier": "^3.4.2",
    "supertest": "^7.0.0",
    "ts-jest": "^29.4.15",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22.9"
  },
  "overrides": {
    "multer": "2.5.0",
    "minimatch": "^11.0.8",
    "glob": "^14.0.6"
  }
}
