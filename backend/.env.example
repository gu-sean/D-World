NODE_ENV=development
PORT=3000
# 관리자 웹 Origin(쉼표로 여럿 가능), 비우면 CORS 비활성
ADMIN_WEB_ORIGIN=
# 루트 docker-compose.yml의 postgres 기준 (docker compose up -d postgres)
DATABASE_URL=postgres://dworld:dworld@localhost:5432/d_world
DATABASE_POOL_MAX=10
DATABASE_SSL=false
# DATABASE_SSL=true일 때 서버 인증서를 검증할 CA 파일 (Supabase: certs/supabase-prod-ca-2021.crt), 비우면 시스템 기본 CA
DATABASE_SSL_CA=
DATABASE_STATEMENT_TIMEOUT_MS=30000
DATABASE_IDLE_TX_TIMEOUT_MS=60000
# 리버스 프록시 뒤에서만 true
TRUST_PROXY=false
# 각 32자 이상, 서로 다른 값 (예: openssl rand -base64 48)
# JWT_ACCESS_SECRET은 휴대폰 인증 단계 토큰·소셜 가입 토큰 서명에도 쓴다
JWT_ACCESS_SECRET=
ADMIN_JWT_SECRET=
ACCESS_TOKEN_TTL_SEC=1800
ADMIN_ACCESS_TOKEN_TTL_SEC=900
REFRESH_TOKEN_TTL_DAYS=30
# 개발 전용 console(인증번호를 로그에 출력), 운영은 공급자 구현 필요(현재 console만 구현, 공급자 미정)
SMS_DRIVER=console
# 푸시: console(개발 전용, 운영 거부) 또는 fcm(아래 서비스 계정 중 하나 필요)
# 키가 맞는지는 npm run push:check 로 점검 (실제 발송 없이 dryRun), 발급·설정 순서는 README "푸시(FCM) 설정"
PUSH_DRIVER=console
FCM_SERVICE_ACCOUNT_JSON=
FCM_SERVICE_ACCOUNT_PATH=
# 인증번호 해시에 섞는 서버 비밀(32자 이상), 비우면 JWT_ACCESS_SECRET 사용
PHONE_CODE_PEPPER=
# 소셜 검증: real, mock(개발 전용, `mock:{subject}:{email}` 토큰을 그대로 신뢰, 운영 거부)
SOCIAL_DRIVER=real
APPLE_CLIENT_ID=
# 쉼표 구분
GOOGLE_CLIENT_IDS=
NAVER_PROFILE_URL=https://openapi.naver.com/v1/nid/me
# 날씨 (상황 추천에 쓰임, 실패하면 날씨 없이 추천). 실제 날씨는 kma 권장
#   mock        항상 "맑음 20도" (개발·테스트용, 키 불필요) ← 기본
#   kma         기상청 API허브(apihub.kma.go.kr) 초단기실황·초단기예보, KMA_AUTH_KEY 필수(없으면 서버가 뜨지 않음)
#   openweather OpenWeather, OPENWEATHER_API_KEY 필요
# 키가 맞는지는 npm run weather:check 로 점검, 발급·설정 순서는 README "날씨 설정"
WEATHER_DRIVER=mock
KMA_AUTH_KEY=
OPENWEATHER_API_KEY=
# 인증 원본 저장소: memory는 개발 전용(운영 금지), 운영은 r2와 아래 R2_* 모두 필요
STORAGE_DRIVER=memory
# 객체 키 맨 앞 접두어(환경 구분), 로컬 MinIO면 시작 때 버킷 자동 생성
R2_KEY_PREFIX=dev
R2_CREATE_BUCKET=false
# 로컬 MinIO(docker compose의 minio)를 쓰려면 R2_ENDPOINT=http://localhost:9000, 키는 minioadmin, 버킷은 콘솔(9001)에서 생성
R2_ENDPOINT=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_UPLOAD_URL_TTL_SEC=900
# 내부 호출(AI ↔ 백엔드) 공유 토큰(32자 이상), X-Internal-Token 헤더, 비우면 수신 엔드포인트가 꺼짐
INTERNAL_API_TOKEN=

# 정기 작업(AI 판정 요청, 파일 정리, 미션 마감, 제안 만료 등)을 끄려면 true, 다중 인스턴스면 한 곳만 켜 둠
JOBS_DISABLED=false
# AI 서버 주소(호스트까지, 끝의 /internal/v1은 있어도 됨), INTERNAL_API_TOKEN과 함께 있어야 판정 요청이 켜짐 (예: http://localhost:8001)
AI_SERVICE_URL=
# AI가 콜백을 보낼 이 서버의 공개 주소, AI의 BACKEND_CALLBACK_URL = {값}/internal/v1/ai-callbacks (비우면 http://localhost:PORT)
BACKEND_PUBLIC_URL=
# AI 서버 호출 기본 타임아웃(ms)
AI_REQUEST_TIMEOUT_MS=10000
# 판정 요청에 파일을 알리는 방식: object_key(키만) 또는 signed_url(키+downloadUrl, AI 스키마 변경 후에만)
AI_MEDIA_ACCESS=object_key
# AI 판정 요청의 서명 URL 유효 시간(초): 요청·재시도마다 새로 발급 (signed_url 방식일 때 쓰임)
AI_SIGNED_URL_TTL_SEC=600
# 러닝 센서 인증(I02)을 AI에 보낼지: AI의 센서 라우터(/sensor/evaluations)가 준비되기 전에는 false(기본), 센서 인증은 바로 관리자 검수
AI_SENSOR_ENABLED=false
AI_SENSOR_TIMEOUT_MS=30000
# 사진 증거를 AI에 보낼지: AI가 영상만 판정하므로 false(기본)면 사진은 AI 없이 바로 관리자 검수 (업로드는 허용)
AI_PHOTO_ENABLED=false
# 계획 생성(I03), 상황 추천(I04) 타임아웃(ms)
AI_PLAN_TIMEOUT_MS=60000
AI_RECOMMEND_TIMEOUT_MS=15000
