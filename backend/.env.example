NODE_ENV=development
PORT=3000
# 쉼표 구분, 비우면 CORS 비활성
CORS_ORIGINS=
# 루트 docker-compose.yml의 postgres 기준 (docker compose up -d postgres)
DATABASE_URL=postgres://dworld:dworld@localhost:5432/d_world
DATABASE_POOL_MAX=10
DATABASE_SSL=false
DATABASE_STATEMENT_TIMEOUT_MS=30000
DATABASE_IDLE_TX_TIMEOUT_MS=60000
# 리버스 프록시 뒤에서만 true
TRUST_PROXY=false
# 각 32자 이상, 서로 다른 값 (예: openssl rand -base64 48)
JWT_ACCESS_SECRET=
ADMIN_JWT_SECRET=
ACCESS_TOKEN_TTL_SEC=1800
ADMIN_ACCESS_TOKEN_TTL_SEC=900
REFRESH_TOKEN_TTL_DAYS=30
# 개발 전용 console(인증번호를 로그에 출력), 운영은 공급자 구현 필요
SMS_PROVIDER=console
APPLE_CLIENT_ID=
# 쉼표 구분
GOOGLE_CLIENT_IDS=
NAVER_PROFILE_URL=https://openapi.naver.com/v1/nid/me
# 인증 원본 저장소: memory는 개발 전용(운영 금지), 운영은 r2와 아래 R2_* 모두 필요
STORAGE_PROVIDER=memory
# 로컬 MinIO(docker compose의 minio)를 쓰려면 R2_ENDPOINT=http://localhost:9000, 키는 minioadmin, 버킷은 콘솔(9001)에서 생성
R2_ENDPOINT=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_UPLOAD_URL_TTL_SEC=300
# AI 서비스가 판정 결과를 보낼 때 쓰는 공유 비밀(32자 이상), 비우면 수신 엔드포인트가 꺼짐
AI_INGEST_SECRET=

# 주기 작업(AI 판정 요청, 파일 정리, 미션 마감, AI 제안 만료), 한 인스턴스에서만 true 권장
JOBS_ENABLED=false
# AI 서비스 판정 요청(규격 확정 전 임시), 둘 다 있어야 켜짐
AI_SERVICE_URL=
AI_SERVICE_SECRET=

